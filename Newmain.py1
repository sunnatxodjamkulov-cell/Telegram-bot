# =====================================
# DATABASE
# =====================================

def db():
    con = sqlite3.connect(DB)
    con.row_factory = sqlite3.Row
    return con


def init_db():
    con = db()
    c = con.cursor()

    c.execute("""
    CREATE TABLE IF NOT EXISTS countries (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        owner_id INTEGER UNIQUE,
        name TEXT,
        capital TEXT,
        flag TEXT,
        emblem TEXT,
        constitution TEXT,
        money INTEGER DEFAULT 10000,
        population INTEGER DEFAULT 1000,
        cities INTEGER DEFAULT 1,
        last_tick REAL,
        created REAL
    )
    """)

    c.execute("""
    CREATE TABLE IF NOT EXISTS applications (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER,
        name TEXT,
        capital TEXT,
        flag TEXT,
        emblem TEXT,
        constitution TEXT,
        status TEXT DEFAULT 'pending'
    )
    """)

    c.execute("""
    CREATE TABLE IF NOT EXISTS diplomacy (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        sender INTEGER,
        receiver INTEGER,
        status TEXT DEFAULT 'pending'
    )
    """)

    c.execute("""
    CREATE TABLE IF NOT EXISTS treaties (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        country1 INTEGER,
        country2 INTEGER,
        UNIQUE(country1, country2)
    )
    """)

    c.execute("""
    CREATE TABLE IF NOT EXISTS wars (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        attacker INTEGER,
        defender INTEGER,
        status TEXT DEFAULT 'active',
        created REAL
    )
    """)

    c.execute("""
    CREATE TABLE IF NOT EXISTS daily_claims (
        country_id INTEGER,
        claim_day INTEGER,
        PRIMARY KEY(country_id, claim_day)
    )
    """)

    # Eski bazani yangilash
    columns = [
        x["name"] for x in
        c.execute("PRAGMA table_info(countries)").fetchall()
    ]

    new_columns = {
        "army": "INTEGER DEFAULT 0",
        "defense": "INTEGER DEFAULT 0",
        "factories": "INTEGER DEFAULT 0",
        "technology": "INTEGER DEFAULT 1",
        "prestige": "INTEGER DEFAULT 0",
        "happiness": "INTEGER DEFAULT 80"
    }

    for name, definition in new_columns.items():
        if name not in columns:
            c.execute(
                f"ALTER TABLE countries ADD COLUMN {name} {definition}"
            )

    con.commit()
    con.close()


def get_country(uid):
    con = db()
    row = con.execute(
        "SELECT * FROM countries WHERE owner_id=?", (uid,)
    ).fetchone()
    con.close()
    return row


def get_country_id(cid):
    con = db()
    row = con.execute(
        "SELECT * FROM countries WHERE id=?", (cid,)
    ).fetchone()
    con.close()
    return row


def get_treaty(a, b):
    x, y = sorted((a, b))
    con = db()
    result = con.execute(
        "SELECT id FROM treaties WHERE country1=? AND country2=?",
        (x, y)
    ).fetchone()
    con.close()
    return result is not None


